<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- the Remote widget's stick as a floating window (StickOverlay); optional, falls back to StickActivity -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <application
        android:name=".ArchonApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Archon">
        <!-- Landscape only, like the PWA (locked 2026-11-11). configChanges keeps the activity
             alive across a 180° flip instead of recreating it (the probe's double start). -->
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- Send to rig (#123 E): any text or file(s) from the share sheet → a small card over the
             sending app → POST /share/api. No screenOrientation: it floats over portrait apps too. -->
        <activity android:name=".ShareActivity" android:exported="true" android:label="Send to rig"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- The PiP window's buttons (mic / stop); not exported: only the system PiP menu fires them. -->
        <receiver android:name=".stream.PipActions" android:exported="false" />
        <!-- Site-19 tap-anywhere (#123 A): any NfcA tag (the Level-5 card is NTAG, 7-byte UID) with
             the phone unlocked → its UID to POST /site19/toggle. Other tags are fine (user). -->
        <activity android:name=".Site19Tap" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data android:name="android.nfc.action.TECH_DISCOVERED" android:resource="@xml/nfc_tech" />
        </activity>
        <!-- Launcher shortcuts: fire one request, toast, close (no UI, never in recents). -->
        <activity android:name=".ShortcutActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="" />
        <!-- Quick Settings tiles (canvas Main board). -->
        <service android:name=".tiles.ListenTile" android:exported="true" android:label="Listen"
            android:icon="@drawable/ic_tile_listen" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".tiles.RigMusicTile" android:exported="true" android:label="Rig music"
            android:icon="@drawable/ic_tile_music" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".tiles.ScreensTile" android:exported="true" android:label="Screens"
            android:icon="@drawable/ic_tile_screens" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
            <meta-data android:name="android.service.quicksettings.TILE_CATEGORY" android:value="android.service.quicksettings.CATEGORY_DISPLAY" />
        </service>
        <!-- The stream (tasks #122): owns the WebRTC session so audio and the phone mic survive the
             screen locking; carries the lock-screen player. -->
        <service android:name=".stream.StreamService" android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone" />
        <!-- Lightning, 4x2 (canvas Widget board; was "Remote" until the full remote, #143). No
             android:configure (handoff §9.7). Same class, so placed widgets keep working. -->
        <receiver android:name=".widget.RemoteReceiver" android:exported="true" android:label="Lightning">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/remote_info" />
        </receiver>
        <!-- Remote, the full-screen TV remote (canvas RemoteControl board v2, #143). -->
        <receiver android:name=".widget.RemoteControlReceiver" android:exported="true" android:label="Remote">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/rc_info" />
        </receiver>
        <!-- The stick tap when "Display over other apps" is on: shows StickOverlay. -->
        <receiver android:name=".StickReceiver" android:exported="false" />
        <!-- The remote's stick, awake: a small window over the widget's stick (no fingerprint, like
             the tiles; any outside touch, pause or 30 s idle ends it). -->
        <activity android:name=".StickActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="" />
        <!-- File shares upload here, so leaving the share card or locking the phone doesn't stop them. -->
        <service android:name=".share.ShareService" android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
