<?xml version="1.0" encoding="utf-8"?>
<!-- Remote control widget (canvas RemoteControl board, #143). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="226dp" android:height="226dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="50%" android:centerX="0.5" android:centerY="0.45"
                android:startColor="#FF0A0606" android:centerColor="#FF160E0E" android:endColor="#FF1F1515" />
            <stroke android:width="2dp" android:color="#FF3A2020" />
        </shape>
    </item>
    <item android:left="22dp" android:top="22dp" android:right="22dp" android:bottom="22dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#FF2A1A1A" /></shape>
    </item>
</layer-list>
